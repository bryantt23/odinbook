<h1><%= @post.subject %></h1>

<p><%= @post.content %></p>

<%= link_to "Back", posts_path %>

<%= button_to "Edit", edit_post_path(@post), method: :get, disabled: @post.user_id!=current_user.id %>
<%= button_to "Delete", @post, method: :delete, data: { turbo_confirm: "Are you sure?" }, disabled: 
@post.user_id!=current_user.id %>
