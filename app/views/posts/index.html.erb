<h1>Posts</h1>

<ul>
    <% @posts.each do |post| %>
        <li>
            <%= link_to post.subject, post %> by <%= post.user.email %>
        </li>
    <% end %>
</ul>

<p>
    user posts
    <%= @user_posts.to_a %>
    </p>
<p>
    following posts
    <%= @following_posts.to_a %>
    </p>


<p>
   current posts + following posts
    <%= @current_following_posts.to_a %>
    </p>
