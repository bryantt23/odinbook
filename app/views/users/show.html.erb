<h1>User info</h1>

<p><%= "User id: #{@user.id}"%></p>
<p><%= "User email: #{@user.email}"%></p>

<ul>
    <% @user.posts.each do |post| %>
        <li>
            <%= link_to post.subject, post %>            
        </li>
    <% end %>
</ul>

<h2>Following</h2>
<% if @friendships.length==0 %>
    Not following anyone yet
<% else %>
    <ul>
        <% @friendships.each do |friendship| %>
            <li><%= friendship.friend.email %></li>
        <% end %>
    </ul>
<% end %>

<h2>Followed by</h2>
<% if @inverse_friendships.length==0 %>
    No followers 
<% else %>
    <ul>
        <% @inverse_friendships.each do |friendship| %>
        <li><%= friendship.user.email %></li>
        <% end %>
    </ul>
<% end %>

