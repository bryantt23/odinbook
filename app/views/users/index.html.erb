<h1>Users</h1>

<ul>
    <% @users.each do |user| %>
        <li>
            <%= link_to "User #{user.id}", user_path(user.id) %>      
            <% if user.id==current_user.id %> 
                Me
            <% elsif current_user.friendships.any?{|friendship| friendship.friend_id==user.id} %>
                Following 
            <% else %>
                <%= button_to "Follow User", friendships_path(friend_id: user.id), method: :post %>
            <% end %>
        </li>
    <% end %>
</ul>